{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "types": ["node"],
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitOverride": true,
    "skipLibCheck": true,
    "noEmit": true,
    "paths": {
      "@gms/contracts": ["../../packages/contracts/src/index.ts"],
      "@gms/domain": ["../../packages/domain/src/index.ts"]
    }
  },
  "include": ["src"]
}
